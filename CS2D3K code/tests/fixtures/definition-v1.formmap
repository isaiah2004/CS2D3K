			"y": 1500,
			"width": 760,
			"height": 820,
			"color": "2",
			"defaultKind": "question",
			"locked": true,
			"order": 7
		},
		{
			"id": "70f58904dba41ecc",
			"type": "zone",
			"label": "Idea inbox",
			"emoji": "📥",
			"prompt": "Dump raw ideas here. Drag them into a zone when they are ready.",
			"x": -500,
			"y": 420,
			"width": 420,
			"height": 1900,
			"color": "3",
			"defaultKind": "idea",
			"locked": true
		},
		{
			"id": "cc3fc1626e53a130",
			"type": "form",
			"kind": "note",
			"title": "CS2D3K — Constrained State Space Documentation Defined Development Kit",
			"text": "Pronounced *CS2-Deck*. The new way to write software in the AI era: bring out **every ounce of ability** in AI models while building **Secure, Scalable and Satisfying** software — in that order.\n\nDocumentation defines the project; agents do the mundane. And we bring the **fun** back into software development.",
			"fields": {},
			"x": 40,
			"y": 90,
			"width": 1560,
			"height": 200
		},
		{
			"id": "43b026c48bbf33fe",
			"type": "form",
			"kind": "principle",
			"title": "1. Don't read all the agent's code",
			"text": "There is little to no point reading all the code your agent writes.",
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 500,
			"width": 340,
			"height": 130
		},
		{
			"id": "ff9243a8f506b409",
			"type": "form",
			"kind": "principle",
			"title": "2. Don't reinvent the wheel",
			"text": "Never make an agent write code it could have copy-pasted or paraphrased.",
			"fields": {
				"strength": 4
			},
			"x": 390,
			"y": 500,
			"width": 340,
			"height": 130
		},
		{
			"id": "28b5b7a767c76fb0",
			"type": "form",
			"kind": "principle",
			"title": "3. Do nearly all the thinking",
			"text": "Agents act as your muscle memory: they do the mundane.",
			"fields": {
				"strength": 5
			},
			"x": 30,
			"y": 650,
			"width": 340,
			"height": 130
		},
		{
			"id": "08f86bebb2737f6a",
			"type": "form",
			"kind": "principle",
			"title": "4. Parallelize heavily",
			"text": "Get used to heavy parallelization of work.",
			"fields": {
				"strength": 4
			},
			"x": 390,
			"y": 650,
			"width": 340,
			"height": 130
		},
		{
			"id": "6f0fb23c6f5da2ce",
			"type": "form",
			"kind": "principle",
			"title": "5. Over-test, over-critique, over-validate",
			"text": "",
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 800,
			"width": 340,
			"height": 130
		},
		{
			"id": "c255404e4fb44003",
			"type": "form",
			"kind": "principle",
			"title": "6. Prompts are code",
			"text": "Prompt quality is everything. Write prompts as though they were code.",
			"fields": {
				"strength": 5
			},
			"x": 390,
			"y": 800,
			"width": 340,
			"height": 130
		},
		{
			"id": "4d6608697a8d41be",
			"type": "form",
			"kind": "principle",
			"title": "7. Test every scenario end-to-end",
			"text": "Full end-to-end testing of every possible scenario, plus agentic testing.",
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 950,
			"width": 340,
			"height": 130
		},
		{
			"id": "d440e50454f31af3",
			"type": "form",
			"kind": "principle",
			"title": "8. Ultra-granular logging",
			"text": "Easy-to-toggle, ultra-granular logging.",
			"fields": {
				"strength": 4
			},
			"x": 390,
			"y": 950,
			"width": 340,
			"height": 130
		},
		{
			"id": "176813e02ea68ef7",
			"type": "form",
			"kind": "principle",
			"title": "9. Multiple passes",
			"text": "Write the code in multiple passes, focusing on a subset of requirements at a time.",
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 1100,
			"width": 340,
			"height": 130
		},
		{
			"id": "86e4d3cea27d2693",
			"type": "form",
			"kind": "principle",
			"title": "10. Validate prompts, not code",
			"text": "Validate your prompts so you don't have to validate your code.",
			"fields": {
				"strength": 5
			},
			"x": 390,
			"y": 1100,
			"width": 340,
			"height": 130
		},
		{
			"id": "4b484e73cf575dca",
			"type": "form",
			"kind": "principle",
			"title": "11. Sonnet executes, Opus/Fable orchestrate",
			"text": "Plans must be executable by Sonnet; Opus and Fable do the orchestration and checks.",
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 1250,
			"width": 340,
			"height": 130
		},
		{
			"id": "d6ba2b0aee0ca923",
			"type": "form",
			"kind": "approach",
			"title": "Documentation-defined development",
			"text": "Every project = Definition → Architecture → Code. Docs are the source of truth; code is derived from them.",
			"fields": {
				"status": "accepted",
				"rationale": "Every project = Definition → Architecture → Code. Docs are the source of truth; code is derived from them."
			},
			"x": 870,
			"y": 500,
			"width": 340,
			"height": 260
		},
		{
			"id": "ad84173581569969",
			"type": "form",
			"kind": "approach",
			"title": "Constrained state space",
			"text": "Each pass may only change one layer (definition, architecture or code), keeping agent work predictable.",
			"fields": {
				"status": "proposed",
				"rationale": "Each pass may only change one layer (definition, architecture or code), keeping agent work predictable."
			},
			"x": 1230,
			"y": 500,
			"width": 340,
			"height": 260
		},
		{
			"id": "12c9791e558e08ba",
			"type": "form",
			"kind": "approach",
			"title": "Model tiering",
			"text": "Sonnet executes plans; Opus/Fable orchestrate, review and check.",
			"fields": {
				"status": "accepted",
				"rationale": "Sonnet executes plans; Opus/Fable orchestrate, review and check."
			},
			"x": 870,
			"y": 790,
			"width": 340,
			"height": 260
		},
		{
			"id": "2824c1c099724caf",
			"type": "form",
			"kind": "approach",
			"title": "Parallel task queue",
			"text": "Refined ideas are queued and executed in parallel; each first lands as a reviewable artifact.",
			"fields": {
				"status": "accepted",
				"rationale": "Refined ideas are queued and executed in parallel; each first lands as a reviewable artifact."
			},
			"x": 1230,
			"y": 790,
			"width": 340,
			"height": 260
		},
		{
			"id": "7efc2f91624a8940",
			"type": "form",
			"kind": "approach",
			"title": "Validate everything",
			"text": "E2E + agentic tests and toggleable granular logs on every change.",
			"fields": {
				"status": "accepted",
				"rationale": "E2E + agentic tests and toggleable granular logs on every change."
			},
			"x": 870,
			"y": 1080,
			"width": 340,
			"height": 260
		},
		{
			"id": "bca3a0aac36098b2",
			"type": "form",
			"kind": "approach",
			"title": "Multi-pass implementation",
			"text": "Build in passes, each focused on a subset of requirements.",
			"fields": {
				"status": "proposed",
				"rationale": "Build in passes, each focused on a subset of requirements."
			},
			"x": 1230,
			"y": 1080,
			"width": 340,
			"height": 260
		},
		{
			"id": "6bd0c621de49f145",
			"type": "form",
			"kind": "goal",
			"title": "Secure, Scalable, Satisfying — in that order",
			"text": "Every shipped project passes security review, scales, and delights its users.",
			"fields": {
				"horizon": "final",
				"metric": "Security issues found after release → 0"
			},
			"x": 1720,
			"y": 500,
