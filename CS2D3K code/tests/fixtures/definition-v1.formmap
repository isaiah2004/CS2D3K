{
	"formmap": {
		"version": 1,
		"title": "CS2D3K Definition",
		"template": "product-definition",
		"mvpBudget": 24
	},
	"nodes": [
		{
			"id": "a4c123b1612dd272",
			"type": "zone",
			"label": "Core idea",
			"emoji": "🌱",
			"prompt": "One or two sentences: what is this product and why must it exist?",
			"x": 0,
			"y": 0,
			"width": 2440,
			"height": 340,
			"color": "3",
			"defaultKind": "note",
			"locked": true,
			"order": 1
		},
		{
			"id": "d1371c17149d4395",
			"type": "zone",
			"label": "Philosophy",
			"emoji": "🧭",
			"prompt": "The beliefs that drive every decision. If a feature fights a principle, the principle wins.",
			"x": 0,
			"y": 420,
			"width": 760,
			"height": 1000,
			"color": "6",
			"defaultKind": "principle",
			"locked": true,
			"order": 2
		},
		{
			"id": "36b3216fdaeeb975",
			"type": "zone",
			"label": "Engineering approach",
			"emoji": "🛠️",
			"prompt": "How we build it: stack, process and the key technical decisions — each with a rationale.",
			"x": 840,
			"y": 420,
			"width": 760,
			"height": 1000,
			"color": "5",
			"defaultKind": "approach",
			"locked": true,
			"order": 3
		},
		{
			"id": "729fae923d5a4fd1",
			"type": "zone",
			"label": "Final goal",
			"emoji": "🎯",
			"prompt": "What does success look like? Make it measurable.",
			"x": 1680,
			"y": 420,
			"width": 760,
			"height": 1000,
			"color": "1",
			"defaultKind": "goal",
			"locked": true,
			"order": 4,
			"assign": {
				"horizon": "final"
			}
		},
		{
			"id": "2aabfe228f219e9c",
			"type": "zone",
			"label": "Initial features (MVP)",
			"emoji": "🚀",
			"prompt": "The smallest set of features that proves the core idea. Every one should serve a goal.",
			"x": 0,
			"y": 1500,
			"width": 760,
			"height": 820,
			"color": "4",
			"defaultKind": "feature",
			"locked": true,
			"order": 5,
			"assign": {
				"phase": "mvp"
			}
		},
		{
			"id": "b0eb53f16947ccf2",
			"type": "zone",
			"label": "Later features",
			"emoji": "🔭",
			"prompt": "Good ideas that are not needed to prove the core idea. Park them here guilt-free.",
			"x": 840,
			"y": 1500,
			"width": 760,
			"height": 820,
			"color": "5",
			"defaultKind": "feature",
			"locked": true,
			"order": 6,
			"assign": {
				"phase": "later"
			}
		},
		{
			"id": "5ec84d8dbc742547",
			"type": "zone",
			"label": "Open questions",
			"emoji": "❓",
			"prompt": "Unknowns and risks. Decide them, or explicitly park them.",
