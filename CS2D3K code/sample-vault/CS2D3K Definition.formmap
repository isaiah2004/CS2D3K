				"size": {
					"width": 280,
					"height": 150
				},
				"child": "feature",
				"hint": "An outcome we want. Features should serve goals."
			},
			{
				"id": "approach",
				"name": "Approach",
				"emoji": "🛠️",
				"tags": [
