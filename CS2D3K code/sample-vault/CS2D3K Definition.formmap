			"color": "3",
			"preset": "idea",
			"locked": true
		},
		{
			"id": "cc3fc1626e53a130",
			"type": "form",
			"title": "CS2D3K — Constrained State Space Documentation Defined Development Kit",
			"text": "Pronounced *CS2-Deck*. The new way to write software in the AI era: bring out **every ounce of ability** in AI models while building **Secure, Scalable and Satisfying** software — in that order.\n\nDocumentation defines the project; agents do the mundane. And we bring the **fun** back into software development.",
			"tags": [
				"note"
			],
			"fields": {},
			"x": 40,
			"y": 90,
			"width": 1560,
			"height": 200
		},
		{
			"id": "43b026c48bbf33fe",
			"type": "form",
			"title": "1. Don't read all the agent's code",
			"text": "There is little to no point reading all the code your agent writes.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 500,
			"width": 340,
			"height": 130
		},
		{
			"id": "ff9243a8f506b409",
			"type": "form",
			"title": "2. Don't reinvent the wheel",
			"text": "Never make an agent write code it could have copy-pasted or paraphrased.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 4
			},
			"x": 390,
			"y": 500,
			"width": 340,
			"height": 130
		},
		{
			"id": "28b5b7a767c76fb0",
			"type": "form",
			"title": "3. Do nearly all the thinking",
			"text": "Agents act as your muscle memory: they do the mundane.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 5
			},
			"x": 30,
			"y": 650,
			"width": 340,
			"height": 130
		},
		{
			"id": "08f86bebb2737f6a",
			"type": "form",
			"title": "4. Parallelize heavily",
			"text": "Get used to heavy parallelization of work.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 4
			},
			"x": 390,
			"y": 650,
			"width": 340,
			"height": 130
		},
		{
			"id": "6f0fb23c6f5da2ce",
			"type": "form",
			"title": "5. Over-test, over-critique, over-validate",
			"text": "",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 800,
			"width": 340,
			"height": 130
		},
		{
			"id": "c255404e4fb44003",
			"type": "form",
			"title": "6. Prompts are code",
			"text": "Prompt quality is everything. Write prompts as though they were code.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 5
			},
			"x": 390,
			"y": 800,
			"width": 340,
			"height": 130
		},
		{
			"id": "4d6608697a8d41be",
			"type": "form",
			"title": "7. Test every scenario end-to-end",
			"text": "Full end-to-end testing of every possible scenario, plus agentic testing.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 950,
			"width": 340,
			"height": 130
		},
		{
			"id": "d440e50454f31af3",
			"type": "form",
			"title": "8. Ultra-granular logging",
			"text": "Easy-to-toggle, ultra-granular logging.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 4
			},
			"x": 390,
			"y": 950,
			"width": 340,
			"height": 130
		},
		{
			"id": "176813e02ea68ef7",
			"type": "form",
			"title": "9. Multiple passes",
			"text": "Write the code in multiple passes, focusing on a subset of requirements at a time.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 1100,
			"width": 340,
			"height": 130
		},
		{
			"id": "86e4d3cea27d2693",
			"type": "form",
			"title": "10. Validate prompts, not code",
			"text": "Validate your prompts so you don't have to validate your code.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 5
			},
			"x": 390,
			"y": 1100,
			"width": 340,
			"height": 130
		},
		{
			"id": "4b484e73cf575dca",
			"type": "form",
			"title": "11. Sonnet executes, Opus/Fable orchestrate",
			"text": "Plans must be executable by Sonnet; Opus and Fable do the orchestration and checks.",
			"tags": [
				"principle"
			],
			"fields": {
				"strength": 4
			},
			"x": 30,
			"y": 1250,
			"width": 340,
			"height": 130
		},
