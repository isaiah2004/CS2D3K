	"nodes": [
		{
			"id": "a4c123b1612dd272",
			"type": "group",
			"label": "Core idea",
			"emoji": "🌱",
			"prompt": "One or two sentences: what is this product and why must it exist?",
			"x": 0,
			"y": 0,
			"width": 2440,
			"height": 340,
			"color": "3",
			"preset": "note",
			"locked": true,
			"order": 1
		},
		{
			"id": "d1371c17149d4395",
			"type": "group",
			"label": "Philosophy",
			"emoji": "🧭",
			"prompt": "The beliefs that drive every decision. If a feature fights a principle, the principle wins.",
			"x": 0,
			"y": 420,
			"width": 760,
			"height": 1000,
			"color": "6",
			"preset": "principle",
			"locked": true,
			"order": 2
		},
		{
			"id": "36b3216fdaeeb975",
			"type": "group",
			"label": "Engineering approach",
			"emoji": "🛠️",
			"prompt": "How we build it: stack, process and the key technical decisions — each with a rationale.",
			"x": 840,
			"y": 420,
			"width": 760,
			"height": 1000,
			"color": "5",
			"preset": "approach",
			"locked": true,
			"order": 3
		},
		{
			"id": "729fae923d5a4fd1",
			"type": "group",
			"label": "Final goal",
			"emoji": "🎯",
			"prompt": "What does success look like? Make it measurable.",
